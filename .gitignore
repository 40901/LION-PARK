# ==============================================================================
# Lion Park — arquivos ignorados pelo controle de versão
# Stack: .NET 10 (C#) · Angular 21 (TypeScript) · PostgreSQL 16 (Docker)
# ==============================================================================
# Princípio: versiona-se código-fonte e configuração declarativa. Tudo que for
# derivável de um build, específico de uma máquina ou sigiloso fica de fora.
# ==============================================================================


# ------------------------------------------------------------------------------
# .NET — saída de compilação
# ------------------------------------------------------------------------------
# bin/ e obj/ são regeneráveis por `dotnet build`. Versioná-los infla o
# repositório, polui todo diff e gera conflito de merge em arquivo binário.
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Artefatos de compilação e depuração
*.dll
*.exe
*.pdb
*.mdb
*.so
*.dylib
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.cache
*.tlog
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tli
*.tlh
*.tmp
*.tmp_proj
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc

# Arquivos gerados pelo SDK durante a restauração
project.assets.json
project.nuget.cache
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache
*.GeneratedMSBuildEditorConfig.editorconfig
*.assets.cache
*.csproj.AssemblyReference.cache
*.csproj.CoreCompileInputs.cache
*.csproj.FileListAbsolute.txt
*.genruntimeconfig.cache
MSBuild_Logs/

# Publicação
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# Pacotes NuGet (restauráveis a partir do .csproj)
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Visual Studio / Rider / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Cobertura e testes
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/
.axoCover/
*.trx


