# ------------------------------------------------------------------------------
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/
*.tsbuildinfo

# Logs de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# UnoCSS — src/uno.css é GERADO por `npm run build:unocss`.
# Não versionar: é derivado das classes usadas no código-fonte.
frontend/src/uno.css

# Testes e cobertura do frontend
/coverage
.nyc_output/
testem.log
__screenshots__/
playwright-report/
test-results/


# ------------------------------------------------------------------------------
# Segredos e configuração por ambiente
# ------------------------------------------------------------------------------
# NUNCA versionar credenciais. Use variáveis de ambiente ou
# `dotnet user-secrets` em desenvolvimento.
appsettings.Production.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
.env
.env.*
!.env.example
frontend/src/environments/environment.prod.ts
frontend/src/app/core/config/environment.local.ts


