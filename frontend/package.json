{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-p start:*",
    "start:ng": "ng serve",
    "start:unocss": "unocss \"src/**/*.html\" \"src/**/*.ts\" -c uno.config.ts -o src/uno.css --watch",
    "build": "run-s build:unocss build:ng",
    "build:ng": "ng build",
    "build:unocss": "unocss \"src/**/*.html\" \"src/**/*.ts\" -c uno.config.ts -o src/uno.css",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@unocss/cli": "^66.6.6",
    "jsdom": "^28.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "unocss": "^66.6.6",
    "vitest": "^4.0.8"
  }
}
